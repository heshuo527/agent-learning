# 复制这个文件为 .env,然后填上自己的 key
# cp .env.example .env

# 必填:百炼 API Key
# 在百炼控制台 → API-KEY 管理 里创建,形如 sk-xxxxxx
DASHSCOPE_API_KEY=

# 接口地址。百炼提供 OpenAI 兼容接口,国内可直接访问。
# 北京地域:  https://dashscope.aliyuncs.com/compatible-mode/v1
# 新加坡地域:https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 子业务空间:北京地域也用上面这个地址,但必须换成该空间的 API Key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名。挑工具调用能力强的即可,不用最贵的。
#   qwen-plus   ← 默认,工具调用稳定、价格适中
#   qwen-flash  更快更便宜,适合反复跑循环做实验
#   qwen-max    效果最好也最贵,第 2 周做效果对比时再换
MODEL=qwen-plus